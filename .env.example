DATABASE_URL=postgres://space_sports:space_sports@localhost:5432/space_sports
REDIS_URL=redis://localhost:6379
# Jobs e workers (BullMQ no Redis): ocorrências e mensalidades de mensalistas, push e lembretes de
# reserva. Padrão: ligado fora de NODE_ENV=test. Com false, nada é gerado/enviado automaticamente.
JOBS_ENABLED=
NODE_ENV=development

# E-mail transacional (verificação de e-mail, reset de senha). Em dev: Mailpit (http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
# Em produção: SMTP do provedor (ex.: Resend), com TLS e credenciais.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Space Sports <nao-responda@spacesports.local>

# Better Auth (rotas em /v1/auth).
# Segredo de assinatura de cookies/tokens (mínimo 32 caracteres): openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública da API, sem caminho (links dos e-mails e callbacks OAuth).
# Obrigatória em produção; em dev, o padrão é http://localhost:$PORT.
BETTER_AUTH_URL=http://localhost:3333
# Origens confiáveis, separadas por vírgula: o web (CORS + checagem de origem do login) e o
# esquema do app Expo (deep links). O exp:// do Expo Go já é aceito em dev.
# exp://* só em desenvolvimento (Expo Go); em produção não confie nele.
TRUSTED_ORIGINS=http://localhost:3000,spacesports://,exp://*
# URL pública do web, usada nos e-mails de convite, no link do convite da reserva e no descadastro.
# Vazio: a primeira origem http(s) acima.
WEB_URL=

# Login social: cada provedor só liga com as duas variáveis preenchidas.
# Google: cliente OAuth "Aplicativo da Web" (Google Cloud Console > APIs e serviços > Credenciais).
# URL de retorno autorizada: <BETTER_AUTH_URL>/v1/auth/callback/google
# (dev: http://localhost:3333/v1/auth/callback/google). O app volta pelo esquema spacesports://,
# que precisa estar em TRUSTED_ORIGINS. Segredo: nunca no git (staging/produção: Parameter Store).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID e o client secret (JWT assinado com a chave .p8; expira em até 6 meses).
# Callback: $BETTER_AUTH_URL/v1/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Bundle id do app iOS, para o login nativo com Apple (idToken).
APPLE_APP_BUNDLE_IDENTIFIER=

# Login por telefone (OTP): desligado em todos os ambientes (decisão 65). Só liga com true e um
# SMS_PROVIDER que envie. Não religue antes de verificar o telefone do cadastro.
AUTH_PHONE_LOGIN_ENABLED=false
# Envio do OTP: `console` loga o código no terminal da API (só dev/test); `none` não envia.
# Padrão: console fora de produção, none em produção (provedor de SMS ainda não escolhido).
SMS_PROVIDER=console

# Rate limit das rotas de auth (/v1/auth) e da busca de CEP, com o contador no Redis (compartilhado entre instâncias).
# Padrão: ligado só em produção. Se o Redis cair, as requisições passam sem limite (e o log avisa).
AUTH_RATE_LIMIT_ENABLED=
# IP do cliente (rate limit e sessions.ip_address). Headers lidos em ordem; vazio = x-forwarded-for.
AUTH_IP_ADDRESS_HEADERS=
# IPs/CIDRs dos proxies reversos à frente da API (ex.: 10.0.3.0/28). Com eles, o IP do cliente é o
# primeiro do x-forwarded-for, da direita para a esquerda, que não é proxy. Sem eles, só um
# x-forwarded-for com um único IP é aceito; com mais de um, todos caem no mesmo limite.
# Use os endereços reais dos proxies, não uma faixa privada larga que também cubra clientes.
AUTH_TRUSTED_PROXIES=

# Geocodificação do endereço dos espaços (Google Maps Platform, Geocoding API). Sem a chave, o
# endereço é salvo sem lat/lng e o espaço fica fora da busca por raio até ajustar o pino no painel.
GOOGLE_MAPS_API_KEY=

# Notificações. O worker de push e lembretes liga com JOBS_ENABLED. Push via Expo
# (https://exp.host); o token de acesso só é necessário se a "enhanced security" estiver ligada
# no projeto Expo.
EXPO_ACCESS_TOKEN=
# Antecedência do lembrete antes da reserva (minutos, 15 a 1440).
BOOKING_REMINDER_LEAD_MIN=120
# Pedido de avaliação: minutos depois do fim da reserva ou da aula (5 a 1380; RN-REVIEW-02).
REVIEW_REQUEST_DELAY_MIN=120

# Fotos (espaços e perfil) no Amazon S3 com CloudFront (decisão 72); o app/web envia direto por
# URL pré-assinada. Sem S3_BUCKET e S3_PUBLIC_URL (os dois juntos), o upload responde 503
# STORAGE_UNAVAILABLE. S3_PUBLIC_URL: base pública das fotos (domínio do CloudFront). S3_REGION:
# padrão sa-east-1. No staging/production não há chaves: vale a cadeia padrão do SDK (infra/README.md).
# Dev com o MinIO do docker-compose (`docker compose --profile storage up -d`, ver apps/api/README.md):
#   S3_BUCKET=space-sports
#   S3_PUBLIC_URL=http://localhost:9000/space-sports
#   S3_ENDPOINT=http://localhost:9000
#   S3_FORCE_PATH_STYLE=true
#   S3_ACCESS_KEY_ID=space_sports
#   S3_SECRET_ACCESS_KEY=space_sports_minio
S3_BUCKET=
S3_PUBLIC_URL=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# Só para dev (MinIO ou uma conta de teste), os dois juntos; sem eles, a cadeia padrão do SDK.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Anúncios (RF-ADS-07, RN-ADS-04): chave HMAC dos tokens de entrega (impressões e cliques), mínimo 32
# caracteres: openssl rand -base64 32. Obrigatória em produção; vazia em dev/test, a API gera uma a
# cada boot (os tokens entregues antes do reinício deixam de contar).
ADS_DELIVERY_SECRET=

# Pagamento online (decisões 80 a 96; docs/13-pagamentos-online.md). Gateway: `fake` (simulado:
# cartões de teste 4111 1111 1111 1111 aprova, 4000 0000 0000 0002 recusa, 4000 0000 0000 0259 aprova
# e contesta; Pix pago pelo simulador do /super) ou `none` (pagamento online desligado). Vazio: `fake`
# fora de NODE_ENV=production e `none` nele. O fake é recusado em produção; o staging, que roda a
# build de produção, declara DEPLOY_ENV=staging para usá-lo.
PAYMENTS_PROVIDER=fake
DEPLOY_ENV=
# Chave AES-256-GCM do documento (CPF/CNPJ) do cadastro no gateway (decisão 97): 32 bytes em base64
# (openssl rand -base64 32). Obrigatória em NODE_ENV=production; vazia no dev e nos testes, a API gera
# uma a cada boot (os documentos gravados com outra chave aparecem vazios no relatório fiscal).
# Nunca trocar a de um ambiente que já tem cadastros.
PAYMENTS_DATA_KEY=
# Chave HMAC dos webhooks do fake (openssl rand -base64 32). Vazia: a API gera uma a cada boot.
PAYMENTS_FAKE_WEBHOOK_SECRET=
# Para onde o fake manda os webhooks. Vazio: a própria API em http://127.0.0.1:PORT.
PAYMENTS_FAKE_WEBHOOK_URL=
# Simulação do fake: aprovação automática do cadastro (ms), chargeback do cartão 0259 (ms),
# liberação do saldo (Pix D+1, cartão D+30) e tarifa do gateway (Pix 0,99%; cartão 3,49% + R$ 0,39).
PAYMENTS_FAKE_APPROVAL_DELAY_MS=5000
PAYMENTS_FAKE_CHARGEBACK_DELAY_MS=60000
PAYMENTS_FAKE_PIX_RELEASE_DAYS=1
PAYMENTS_FAKE_CARD_RELEASE_DAYS=30
PAYMENTS_FAKE_PIX_COST_BPS=99
PAYMENTS_FAKE_CARD_COST_BPS=349
PAYMENTS_FAKE_CARD_COST_FIXED_CENTS=39

# Seed (pnpm db:seed): usuário Super da plataforma. Defina e-mail e nome juntos (ou nenhum).
# A senha (8 a 128 caracteres) só é gravada se o Super ainda não tiver uma; sem ela, o Super
# entra pelo "esqueci a senha". O seed falha, sem promover ninguém, se o e-mail já for de uma
# conta que ele não criou (ex.: cadastro pelo app).
SEED_SUPER_EMAIL=
SEED_SUPER_NAME=
SEED_SUPER_PASSWORD=

# Seed de demonstração (pnpm db:seed:demo, só dev/staging; recusa NODE_ENV=production): senha das
# contas de demonstração (Dono e professores dos parceiros, @exemplo.com). Obrigatória para o
# script, 8 a 128 caracteres; não muda a senha de contas que já existem. Com PAYMENTS_PROVIDER=fake,
# cria também a "Arena Demonstração (fictícia)" com o pagamento online: dono.demo@exemplo.com,
# jogador.demo@exemplo.com, cadastro aprovado, modos ativos e cobranças pagas e estornadas.
SEED_DEMO_PASSWORD=
# Permissão explícita do seed de demonstração, além da trava de NODE_ENV: sem o valor exato `true`
# o script recusa. Defina só no staging, nunca na produção nem no ambiente do contêiner da API; em
# dev, passe na linha de comando quando for rodar o seed.
ALLOW_DEMO_SEED=
