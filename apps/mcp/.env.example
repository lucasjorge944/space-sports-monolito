# Servidor MCP do Space Sports (docs/14-mcp.md). Copie para apps/mcp/.env no desenvolvimento.

# Porta HTTP (padrão 3340) e interface.
PORT=3340
HOST=0.0.0.0
# Chave de emergência (RN-MCP-04): false responde 503 em /mcp sem afetar app e web. Booleano como na
# API: false, 0, off ou no desligam (sem diferença de caixa); outro valor recusa a subida.
MCP_ENABLED=true

# Origem da API, sem /v1. O MCP chama a API com o mesmo Bearer do usuário e X-Client: mcp.
API_URL=http://localhost:3333
# URL pública do web, para os links "conclua no app" (ex.: espaço que só aceita cartão).
WEB_URL=http://localhost:3000

# OAuth (servidor de autorização = Better Auth da API, tarefa MCP.1).
# Emissor (`iss`) dos tokens: BETTER_AUTH_URL da API + /v1/auth.
MCP_ISSUER=http://localhost:3333/v1/auth

# Superfícies (conectores) que este processo serve, separadas por vírgula (decisão 120). Padrão: user
# (conector "Space Sports": jogador e gestão). admin: conector "Space Sports · Plataforma" (só Super,
# super:read). Com mais de uma (ex.: user,admin no staging), a escolha é pelo host e pelo caminho da
# requisição: as URLs de recurso precisam diferir no host ou no caminho.
MCP_SURFACES=user
# Superfície user: URL canônica do recurso, igual ao `aud` dos tokens e ao MCP_RESOURCE_URL da API.
# O caminho dela é o do endpoint MCP. Staging: https://mcp-staging.spacesports.com.br/mcp;
# produção: https://mcp.spacesports.com.br/mcp.
MCP_RESOURCE_URL=http://localhost:3340/mcp
# Superfície admin (obrigatória com admin em MCP_SURFACES): URL canônica do recurso do Super, igual
# ao MCP_ADMIN_RESOURCE_URL da API. Staging: https://mcp-admin-staging.spacesports.com.br/mcp; local,
# no mesmo processo da user: http://localhost:3340/admin/mcp.
MCP_ADMIN_RESOURCE_URL=
# Chave de emergência só da superfície admin: false responde 503 no endpoint e no metadata dela, sem
# afetar a user (a API tem a sua, com o mesmo nome, para o recurso do Super; no staging são dois
# parâmetros, /space-sports/staging/api/MCP_ADMIN_ENABLED e /space-sports/staging/mcp/MCP_ADMIN_ENABLED,
# com o valor false). Booleano como o MCP_ENABLED.
MCP_ADMIN_ENABLED=true
# JWKS do emissor. Vazio: <MCP_ISSUER>/jwks.
MCP_JWKS_URL=

# Segredo do HMAC dos códigos de confirmação de reserva e cancelamento (mínimo 32 caracteres):
# openssl rand -base64 32. Nunca no git (staging/produção: Parameter Store). Trocar o segredo só
# invalida os códigos dos últimos 10 minutos.
MCP_CONFIRMATION_SECRET=

# Hostnames (sem esquema nem porta) aceitos no cabeçalho Origin de /mcp, separados por vírgula.
# Clientes fora do navegador (como o Claude) não mandam Origin e não precisam estar aqui.
# Vazio: nenhum em produção; localhost fora dela.
MCP_ALLOWED_ORIGINS=
# Em produção, API_URL, MCP_ISSUER e MCP_JWKS_URL precisam de HTTPS, salvo loopback ou os hosts
# internos listados aqui (separados por vírgula), ex.: api (o serviço da API no compose).
MCP_INTERNAL_HOSTS=

# fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info
