# URL da API (origem, sem /v1). No emulador Android, localhost é http://10.0.2.2:3333;
# em aparelho físico, use o IP da máquina na rede.
EXPO_PUBLIC_API_URL=http://localhost:3333

# Expo Go em dev: o app abre os links de volta como exp://..., e a API só os aceita se o
# TRUSTED_ORIGINS dela incluir exp://* (ex.: TRUSTED_ORIGINS=http://localhost:3000,spacesports://,exp://*).
# Em build próprio (dev client/EAS) vale o esquema spacesports://, que já está na lista padrão.

# Provedores de login social habilitados na API (GOOGLE_CLIENT_ID/APPLE_CLIENT_ID preenchidos):
# google, apple, separados por vírgula. Vazio = os botões não aparecem.
EXPO_PUBLIC_AUTH_SOCIAL_PROVIDERS=

# Build (ver README, "Build (EAS)"). Lidas pelo app.config.ts; vazias, ficam fora da config.
# Só para referência dos nomes: no build na nuvem vêm das variáveis do EAS (por environment), e
# para `npx expo config` ou o eas-cli local precisam estar EXPORTADAS NO SHELL, porque o eas-cli
# não lê este .env.
# Id do projeto no EAS (extra.eas.projectId, usado pelo push) e conta/organização dona dele.
EAS_PROJECT_ID=
EXPO_OWNER=
# Chave do Google Maps no Android. No EAS: variável "sensitive" (não commite a chave).
GOOGLE_MAPS_ANDROID_API_KEY=
# Caminho do google-services.json (push no Android, FCM). No EAS: variável de arquivo "secret".
# Sem ela vale ./google-services.json, se existir (fora do git).
GOOGLE_SERVICES_JSON=
