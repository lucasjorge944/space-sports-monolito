{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": false,
  "extends": "//",
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      // Código gerado pelo shadcn/ui: mantido próximo do original para facilitar updates.
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "suspicious": { "noDocumentCookie": "off" },
          "correctness": { "useExhaustiveDependencies": "off" }
        }
      }
    }
  ]
}
