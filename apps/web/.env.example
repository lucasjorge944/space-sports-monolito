# Origem da API (sem /v1). Usada no rewrite de /v1 (lida no build) e pelo proxy.ts para validar a sessão.
API_URL=http://localhost:3333

# Provedores sociais ligados na API (GOOGLE_*/APPLE_* no env dela), separados por vírgula: google,apple.
# Vazio: só e-mail e senha. Lido a cada requisição.
AUTH_PROVIDERS=

# URL pública do web (sem barra final), para URL canônica e dados estruturados da página do espaço.
# O domínio ainda não existe (docs/07, pergunta 9); vazio = sem canônica.
SITE_URL=
